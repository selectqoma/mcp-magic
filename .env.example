# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/govcon

# Required: Register at https://sam.gov/profile/details
SAM_GOV_API_KEY=

# Required: OpenAI for embeddings
OPENAI_API_KEY=

# Required: Anthropic for PDF parsing (uses Haiku)
ANTHROPIC_API_KEY=

# Billing (Paddle)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# App
SECRET_KEY=change-me-in-production
DEBUG=false
